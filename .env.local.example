# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bearable_senior

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Amazon Connect (voice calls)
CONNECT_INSTANCE_ID=your_connect_instance_id
CONNECT_CONTACT_FLOW_ID=your_contact_flow_id
CONNECT_PHONE_NUMBER=+1234567890

# AWS SES (email, future use)
SES_FROM_EMAIL=noreply@bearable.ai

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_cron_secret_for_eventbridge
